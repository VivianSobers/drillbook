# Generated by env/terraform. Do not edit.
[control_plane]
%{ for name, n in nodes ~}
%{ if n.role == "control_plane" ~}
${name} ansible_host=${n.ip}
%{ endif ~}
%{ endfor ~}

[workers]
%{ for name, n in nodes ~}
%{ if n.role == "workers" ~}
${name} ansible_host=${n.ip}
%{ endif ~}
%{ endfor ~}

[cluster:children]
control_plane
workers

[cluster:vars]
ansible_user=root
ansible_ssh_private_key_file=${key_file}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR'
ansible_python_interpreter=/usr/bin/python3
